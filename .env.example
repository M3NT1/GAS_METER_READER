# A helyi Apple Vision / Tesseract felismerő használata, távoli szolgáltató nélkül.
GASPHOTO_OCR=local

# A böngészős helyi alkalmazás csak a Feltöltés gomb megnyomásakor használja.
# HA_URL=http://homeassistant.local:8123
# Macen indítás után a Beállításokban egyszer költöztesd át a tokent a Kulcskarikába.
# Szerveren adj meg egy 0400 vagy 0600 jogosultságú, csak olvasható secret-fájlt:
# HA_TOKEN_FILE=/run/secrets/gas_photo_ha_token

# Csak akkor kell, ha a távoli felismerést kifejezetten bekapcsolod.
# GASPHOTO_OCR=vision
# VISION_BASE_URL=https://api.example.invalid/v1
# VISION_MODEL=model-name
# VISION_API_KEY=secret
